<Window x:Class="SkyFireLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SkyFire Launcher"
        Height="560" Width="760"
        MinHeight="480" MinWidth="640"
        Icon="AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgDeepBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource FrameBorderBrush}" BorderThickness="1.5">
        <Grid>
            <!-- Atmosphere -->
            <Rectangle Fill="{StaticResource AtmosphereBrush}"/>
            <Rectangle Fill="{StaticResource EmberGlowBrush}" IsHitTestVisible="False"/>
            <Rectangle Fill="{StaticResource IceGlowBrush}" IsHitTestVisible="False"/>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.45" RadiusX="0.75" RadiusY="0.7" GradientOrigin="0.5,0.4">
                        <GradientStop Color="#00070B14" Offset="0.55"/>
                        <GradientStop Color="#CC070B14" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title chrome -->
                <Grid Grid.Row="0" Background="#66000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="PROJECT SKYFIRE"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GoldBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  LAUNCHER"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="SettingsOpenButton"
                                Style="{StaticResource ChromeIconButton}"
                                Content="⚙"
                                ToolTip="Configuration"
                                Click="SettingsOpenButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource ChromeIconButton}"
                                Content="—"
                                ToolTip="Minimize"
                                Click="MinimizeButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource CloseIconButton}"
                                Content="✕"
                                ToolTip="Close"
                                Click="CloseButton_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>

                <!-- Launch home -->
                <Grid x:Name="LaunchPane" Grid.Row="1" Margin="28,8,28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Row="0"
                           Source="Assets/skyfire-launcher-logo.png"
                           Stretch="Uniform"
                           MaxHeight="300"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <Border Grid.Row="1"
                            Background="#99121826"
                            BorderBrush="#402A3548"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="20,16"
                            Margin="40,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CLIENT VERSION"
                                           Style="{StaticResource FieldLabel}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource IceBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="LaunchVersion32RadioButton"
                                                 Content="32-bit"
                                                 GroupName="LaunchVersion"
                                                 Style="{StaticResource VersionRadio}"/>
                                    <RadioButton x:Name="LaunchVersion64RadioButton"
                                                 Content="64-bit"
                                                 GroupName="LaunchVersion"
                                                 Style="{StaticResource VersionRadio}"/>
                                </StackPanel>

                                <TextBlock x:Name="LaunchStatusTextBlock"
                                           Text="Ready to enter Azeroth."
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button x:Name="LaunchButton"
                                    Grid.Column="1"
                                    Content="PLAY"
                                    Style="{StaticResource PlayButton}"
                                    VerticalAlignment="Center"
                                    Margin="24,0,0,0"
                                    Click="LaunchButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Settings overlay -->
                <Grid x:Name="SettingsPane"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SettingsPaneTransform" Y="18"/>
                    </Grid.RenderTransform>

                    <Border Background="#E6070B14"/>

                    <Border Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource FrameBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28,24"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Configuration" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource ChromeIconButton}"
                                        Content="✕"
                                        ToolTip="Back"
                                        Click="SettingsCloseButton_Click"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,8,0,16">
                                <TextBlock Text="Client Location" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ClientLocationTextBox"
                                             Style="{StaticResource LauncherTextBox}"
                                             Margin="0,0,10,0"/>
                                    <Button x:Name="BrowseButton"
                                            Grid.Column="1"
                                            Content="Browse…"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BrowseButton_Click"/>
                                </Grid>

                                <TextBlock Text="Default Version" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton x:Name="Version32RadioButton"
                                                 Content="32-bit"
                                                 GroupName="ConfigVersion"
                                                 Style="{StaticResource VersionRadio}"/>
                                    <RadioButton x:Name="Version64RadioButton"
                                                 Content="64-bit"
                                                 GroupName="ConfigVersion"
                                                 Style="{StaticResource VersionRadio}"/>
                                </StackPanel>

                                <TextBlock Text="Login Address" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LoginAddressTextBox"
                                         Style="{StaticResource LauncherTextBox}"
                                         Margin="0,0,0,16"/>

                                <CheckBox x:Name="ClearCacheOnLoginCheckBox"
                                          Content="Clear client cache on each login"
                                          Style="{StaticResource LauncherCheckBox}"
                                          Margin="0,0,0,10"/>

                                <CheckBox x:Name="EnableAuthnetLoginCheckBox"
                                          Content="Enable authnet login [experimental]"
                                          Style="{StaticResource LauncherCheckBox}"
                                          Margin="0,0,0,16"/>

                                <Button x:Name="MigrateOpenButton"
                                        Content="Migrate Account to Email Login…"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Click="MigrateOpenButton_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Back"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0"
                                        Click="SettingsCloseButton_Click"/>
                                <Button x:Name="SaveButton"
                                        Content="Save"
                                        Style="{StaticResource SecondaryButton}"
                                        BorderBrush="{StaticResource EmberHotBrush}"
                                        Click="SaveButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Migrate account overlay -->
                <Grid x:Name="MigratePane"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="MigratePaneTransform" Y="18"/>
                    </Grid.RenderTransform>

                    <Border Background="#E6070B14"/>

                    <Border Background="{StaticResource BgPanelBrush}"
                            BorderBrush="{StaticResource FrameBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28,24"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Migrate Account" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource ChromeIconButton}"
                                        Content="✕"
                                        ToolTip="Back"
                                        Click="MigrateCloseButton_Click"/>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,8,0,16">
                                <TextBlock Text="Converts a legacy username account to email login. You will use the email and new password to log in afterward."
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MigrateUsernameTextBox"
                                         Style="{StaticResource LauncherTextBox}"
                                         Margin="0,0,0,16"/>

                                <TextBlock Text="Current Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="MigrateOldPasswordBox"
                                             Style="{StaticResource LauncherPasswordBox}"
                                             Margin="0,0,0,16"/>

                                <TextBlock Text="New Email" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MigrateEmailTextBox"
                                         Style="{StaticResource LauncherTextBox}"
                                         Margin="0,0,0,16"/>

                                <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="MigrateNewPasswordBox"
                                             Style="{StaticResource LauncherPasswordBox}"
                                             Margin="0,0,0,16"/>

                                <TextBlock Text="Confirm New Password" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="MigrateConfirmPasswordBox"
                                             Style="{StaticResource LauncherPasswordBox}"
                                             Margin="0,0,0,16"/>

                                <TextBlock x:Name="MigrateStatusTextBlock"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Back"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,10,0"
                                        Click="MigrateCloseButton_Click"/>
                                <Button x:Name="MigrateSubmitButton"
                                        Content="Migrate"
                                        Style="{StaticResource SecondaryButton}"
                                        BorderBrush="{StaticResource EmberHotBrush}"
                                        Click="MigrateSubmitButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
